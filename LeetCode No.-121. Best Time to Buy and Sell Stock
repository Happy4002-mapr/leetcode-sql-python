 class Solution(object):
    def maxProfit(self, prices):
        
        max_profit = 0
        i = 0
        j = 1
        
        while j < len(prices):
            
            if prices[j] > prices[i]:
                profit = prices[j] - prices[i]
                
                if profit > max_profit:
                    max_profit = profit
            else:
                i = j
            
            j += 1
        
        return max_profit
